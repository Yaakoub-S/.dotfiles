#!/bin/sh

# qt
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_WAYLAND_DISABLE_WINDOWDECORATIONS=1

# gtk
export GTK_BACKEND=wayland
export GTK2_RC_FILES=/home/yaakoub/.config/gtk-2.0/gtkrc
